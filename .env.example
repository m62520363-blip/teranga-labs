# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service (serveur uniquement) : crédits post-paiement, webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès base en local (scripts/db-test.mjs uniquement, optionnel) ---
# Personal Access Token Supabase (préfixe sbp_). À créer sur
# https://supabase.com/dashboard/account/tokens — de préférence un token
# SCOPÉ sur ce seul projet, avec une expiration courte.
# Révoquable au même endroit. La prod n'en dépend pas : elle n'utilise que
# NEXT_PUBLIC_SUPABASE_URL + l'anon key.
# NE JAMAIS coller un token dans une conversation, une issue ou un commit.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Paiement en ligne (Chariow, prestataire unique) ---
# docs : https://chariow.dev/fr/guides/checkout
# Clés depuis app.chariow.com > Paramètres > Clés API (préfixe sk_).
# Scopes minimums de la clé : checkout.write + sales.read.
# NE JAMAIS coller une clé ici, dans un commit ou une conversation.
CHARIOW_API_KEY=
# Secret de signature du Pulse (préfixe whsec_), récupéré sur
# app.chariow.com > Automatisations > Pulses > [pulse] > Aperçu >
# Secret de signature. Distinct de la clé API.
CHARIOW_PULSE_SECRET=
# URL de base de l'API Chariow (ne pas changer en général).
CHARIOW_BASE_URL=https://api.chariow.com/v1
# Slug du produit « Vérification de profil » sur la boutique Chariow.
CHARIOW_VERIFICATION_PRODUCT=verification-profil
# Produit Chariow servant aux paiements de MISSIONS (payé par le client
# au montant convenu). Le montant exact est porté par une VARIANTE DE PRIX
# (price_variant_id) : mappez-les dans app_settings
# `mission_price_variants` {"15000":"pvr_…"} — sinon la variante
# `mission_product_id` peut aussi être posée là (priorité à la variable).
CHARIOW_MISSION_PRODUCT_ID=
#
# Le webhook (Pulse) est servi par /api/payments/webhook : déclarez cette
# URL en HTTPS chez Chariow (Automatisations > Pulses) avec l'événement
# successful.sale. Sécurité : HMAC-SHA256 du corps brut (header
# x-chariow-signature) VÉRIFIÉ côté serveur, puis re-vérification
# GET /v1/sales/{id} (statut + montant) : les Tokens ne sont crédités
# qu'après confirmation.
#
# Configuration boutique Chariow requise (voir docs/DEPLOIEMENT.md) :
#   * produit « Vérification de profil » : slug CHARIOW_VERIFICATION_PRODUCT,
#     prix identique à get_verification_price() (défaut 5000 XOF) ;
#   * 1 produit par pack Tokens avec pour SLUG l'id du pack
#     (discovery, starter, pro, agence), type LICENCE (les achats
#     répétés doivent rester autorisés), prix identiques à
#     token_packages.price_fcfa, devise XOF.
#   La moindre divergence de prix est détectée au Pulse et refusée.

# --- Application ---
# URL publique (utilisée pour les URLs de retour Wave en production).
# En dev localhost suffit ; à surcharger en prod :
# NEXT_PUBLIC_APP_URL=https://terangalabs.sn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Console admin (teranga-labs-admin) ---
# URL publique de la console d'administration (liens "Admin" du site).
# En dev localhost:3001 suffit ; à surcharger en prod :
# NEXT_PUBLIC_ADMIN_URL=https://admin.terangalabs.sn
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Notifications automatiques de briefs ---
# Déclenchées à la publication d'un brief (/poster) : confirmation au
# client (lien de suivi) + alerte aux développeurs de la ville /
# compétences correspondantes. Sans aucun canal, rien n'est envoyé
# (jamais simulé) : les jobs restent en base, marqués « failed ».
#
# 1) Webhook générique Make / n8n (reçoit un JSON par message) :
NOTIFICATION_WEBHOOK_URL=
# 2) OU WhatsApp direct : greenapi | twilio (laisser vide pour désactiver)
WHATSAPP_PROVIDER=
#    Green-API (instance privée, ex: https://api.green-api.com/waInstance{id}/...)
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_URL=https://api.green-api.com
#    Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# 3) OU email (Resend) : utilisé si le destinataire n'a pas de WhatsApp
RESEND_API_KEY=
RESEND_FROM_EMAIL=Devmarket <notifications@terangalabs.sn>