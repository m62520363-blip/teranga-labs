# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service (serveur uniquement) : crédits post-paiement, webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès base en local (scripts/db-test.mjs uniquement, optionnel) ---
# Personal Access Token Supabase (préfixe sbp_). À créer sur
# https://supabase.com/dashboard/account/tokens — de préférence un token
# SCOPÉ sur ce seul projet, avec une expiration courte.
# Révoquable au même endroit. La prod n'en dépend pas : elle n'utilise que
# NEXT_PUBLIC_SUPABASE_URL + l'anon key.
# NE JAMAIS coller un token dans une conversation, une issue ou un commit.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Paiement en ligne (Wave Business Checkout API) ---
# docs.wave.com/checkout — clés depuis business.wave.com (dev portal)
WAVE_API_KEY=
# Secret de vérification des webhooks (header Wave-Signature, HMAC-SHA256).
WAVE_WEBHOOK_SECRET=
# URL de base de l'API Wave (ne pas changer en général).
WAVE_BASE_URL=https://api.wave.com
# Tolérance d'horodatage des webhooks en secondes (limite Wave : 300).
WAVE_WEBHOOK_TOLERANCE=300

# --- Application ---
# URL publique (utilisée pour les URLs de retour Wave en production).
# En dev localhost suffit ; à surcharger en prod :
# NEXT_PUBLIC_APP_URL=https://terangalabs.sn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Console admin (teranga-labs-admin) ---
# URL publique de la console d'administration (liens "Admin" du site).
# En dev localhost:3001 suffit ; à surcharger en prod :
# NEXT_PUBLIC_ADMIN_URL=https://admin.terangalabs.sn
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Notifications automatiques de briefs ---
# Déclenchées à la publication d'un brief (/poster) : confirmation au
# client (lien de suivi) + alerte aux développeurs de la ville /
# compétences correspondantes. Sans aucun canal, rien n'est envoyé
# (jamais simulé) : les jobs restent en base, marqués « failed ».
#
# 1) Webhook générique Make / n8n (reçoit un JSON par message) :
NOTIFICATION_WEBHOOK_URL=
# 2) OU WhatsApp direct : greenapi | twilio (laisser vide pour désactiver)
WHATSAPP_PROVIDER=
#    Green-API (instance privée, ex: https://api.green-api.com/waInstance{id}/...)
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_URL=https://api.green-api.com
#    Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# 3) OU email (Resend) : utilisé si le destinataire n'a pas de WhatsApp
RESEND_API_KEY=
RESEND_FROM_EMAIL=Teranga Labs <notifications@terangalabs.sn>